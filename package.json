{
  "name": "bun-app-updater",
  "version": "0.3.0",
  "description": "Support in-app updates for a Bun app, from a release feed: check, download the release, verify it, install it, relaunch.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "bun": "./src/*.ts",
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./src/"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.5.4"
  }
}
